# Caddy gets and renews the HTTPS certificate for this domain by itself.
# It needs the DNS A record audioguide.royaarkh.com -> 198.44.107.7 and ports 80/443 open.
audioguide.royaarkh.com {
	encode zstd gzip

	# Every page and API call needs the login, so strangers can't spend AI credits.
	# Both values come from the server's .env (see DEPLOY.md).
	basic_auth {
		{$SITE_USER} {$SITE_PASSWORD_HASH}
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	# The web app is a single page: paths like /story/<id> are handled by index.html.
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
