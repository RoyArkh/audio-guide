# cp .env.example .env    (.env is git-ignored; never commit real secrets)

# Letters and digits only in the password: it is embedded in a URL.
POSTGRES_USER=audioguide
POSTGRES_PASSWORD=changemedevonly
POSTGRES_DB=audioguide

# dev also enables /api/scripts and /api/audio for trying out single steps.
APP_ENV=dev

# Text model for writing scripts. Free Gemini key: Google AI Studio.
# Model and URL default to Gemini (backend/app/config.py); override them to swap providers.
LLM_API_KEY=
# LLM_MODEL=gemini-3.1-flash-lite
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Text-to-speech (Gemini). Can be the same key as LLM_API_KEY.
TTS_API_KEY=
# TTS_MODEL=gemini-3.8-flash-lite-tts
# TTS_VOICE=Sulafat

# Where generated audio goes: "local" (backend/media) in dev. Production uses Cloudflare R2;
# docker-compose.prod.yml sets STORAGE=r2 and APP_ENV=production itself.
STORAGE=local
# R2 only (Cloudflare dashboard -> R2 -> Manage API tokens). See DEPLOY.md.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
